# .streamlit/secrets.toml.example
#
# 사용 방법
#   1) 이 파일을 같은 폴더에 secrets.toml 이라는 이름으로 복사합니다.
#        cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   2) 아래 주소를 실제 n8n Webhook 노드의 Production URL 로 바꿉니다.
#
# 주의
#   secrets.toml 은 절대 Git 에 커밋하지 마세요. (.gitignore 에 이미 포함되어 있습니다)
#   Streamlit Community Cloud 에 배포할 때는 파일 대신
#   App settings → Secrets 화면에 같은 내용을 붙여넣습니다.

N8N_WEBHOOK_URL = "https://your-n8n-host.app.n8n.cloud/webhook/dcm-copilot"
